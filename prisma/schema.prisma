generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  plan          String         @default("FREE")
  locale        String         @default("en")
  currency      String         @default("USD")
  country       String         @default("GLOBAL")
  dataResidency String         @default("GLOBAL")
  vatRate       Float          @default(0)
  reportBrand   String         @default("EstiBot AI SaaS")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  projects      Project[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         String      @default("USER")
  tenantId     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects     Project[]
  usageLogs    UsageLog[]
}

model Project {
  id          String       @id @default(cuid())
  tenantId    String
  ownerId     String
  name        String
  description String
  method      String
  hourlyRate  Float
  currency    String       @default("USD")
  country     String       @default("GLOBAL")
  clientName  String?
  status      String       @default("DRAFT")
  riskLevel   String       @default("MEDIUM")
  vatRate     Float        @default(0)
  stateJson   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  estimations Estimation[]

  @@index([tenantId])
  @@index([ownerId])
}

model Estimation {
  id        String   @id @default(cuid())
  projectId String
  version   Int      @default(1)
  method    String   @default("BOTH")
  fpData    String
  ucpData   String
  results   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  action    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

model Subscription {
  id        String   @id @default(cuid())
  tenantId  String
  plan      String   @default("FREE")
  status    String   @default("ACTIVE")
  limits    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
